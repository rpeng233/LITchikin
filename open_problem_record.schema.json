{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rpeng233/LITchikin/main/open_problem_record.schema.json",
  "title": "LITchikin Problem Catalog 1.4",
  "description": "Canonical strict catalog format used by LITchikin generators, viewers, and hosted services.",
  "type": "object",
  "required": [
    "schemaVersion",
    "catalogId",
    "contentUpdatedAt",
    "problems"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.4"
    },
    "catalogId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string"
    },
    "generatedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "contentUpdatedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "lastVerified": {
      "type": "string"
    },
    "problemCount": {
      "type": "integer",
      "minimum": 0
    },
    "problems": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/problemRecord"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "literatureEntry": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "year": {
              "type": [
                "integer",
                "string",
                "null"
              ]
            },
            "description": {
              "type": "string"
            },
            "link": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "commentAuthor": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "displayName"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "displayName": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "comment": {
      "type": "object",
      "required": [
        "id",
        "author",
        "body",
        "createdAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "$ref": "#/$defs/commentAuthor"
        },
        "body": {
          "type": "string"
        },
        "createdAt": {
          "$ref": "#/$defs/timestamp"
        },
        "updatedAt": {
          "oneOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "authors": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "url": {
          "type": "string"
        },
        "page": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "problemNumber": {
          "type": [
            "string",
            "number",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "problemRecord": {
      "type": "object",
      "required": [
        "problem",
        "recordId",
        "contentUpdatedAt",
        "comments"
      ],
      "properties": {
        "recordId": {
          "type": "string",
          "pattern": "^lit:[a-z0-9]+(?:-[a-z0-9]+)*:[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "sourceStatement": {
          "type": "string"
        },
        "problem": {
          "type": "string"
        },
        "wordDescription": {
          "type": "string"
        },
        "mathematicalConditions": {
          "type": "string"
        },
        "comments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/comment"
          }
        },
        "literature": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/literatureEntry"
          }
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "status": {
          "type": "string"
        },
        "lastVerified": {
          "type": "string"
        },
        "tags": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "verificationNotes": {
          "type": "string"
        },
        "generatedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "contentUpdatedAt": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": true
    }
  }
}
